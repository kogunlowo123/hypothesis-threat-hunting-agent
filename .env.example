# Copy to .env and adjust. Every variable is optional.

# Configuration files
# HUNTAGENT_THRESHOLDS_FILE=configs/thresholds.example.yaml
# HUNTAGENT_IOCS_FILE=configs/iocs.example.json
# HUNTAGENT_ALLOWLIST_FILE=configs/allowlist.example.yaml
# HUNTAGENT_GEO_FILE=configs/geo.example.yaml
# HUNTAGENT_SUPPRESSIONS_FILE=configs/suppressions.example.yaml

# Ingestion limits
HUNTAGENT_MAX_LINE_BYTES=200000
HUNTAGENT_MAX_EVENTS=2000000

# Optional model-written summaries
# llm_provider: none | openai | anthropic. The model only sees aggregate counts, never hosts or users.
HUNTAGENT_LLM_PROVIDER=none
# HUNTAGENT_OPENAI_API_KEY=
HUNTAGENT_OPENAI_BASE_URL=https://api.openai.com/v1
HUNTAGENT_OPENAI_CHAT_MODEL=gpt-4o-mini
# HUNTAGENT_ANTHROPIC_API_KEY=
HUNTAGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com
HUNTAGENT_ANTHROPIC_MODEL=claude-sonnet-5
HUNTAGENT_ANTHROPIC_MAX_TOKENS=500

# HTTP and logging
HUNTAGENT_HTTP_TIMEOUT_SECONDS=30
HUNTAGENT_RETRY_ATTEMPTS=3
HUNTAGENT_RETRY_MIN_WAIT=0.5
HUNTAGENT_RETRY_MAX_WAIT=8
HUNTAGENT_LOG_LEVEL=WARNING
HUNTAGENT_LOG_JSON=true
